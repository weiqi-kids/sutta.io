---
// en/topics/[slug].astro — Topic study pages (English mirror)
import Base from '../../../layouts/Base.astro';
import { getStrings } from '../../../i18n';
const t = getStrings(Astro.currentLocale);
import { listTopics, getTopic, resolveTopicQuote, getSutta, suttaSeoTitle } from '../../../lib/data';

export function getStaticPaths() {
  return listTopics().map((tp) => ({ params: { slug: tp.slug } }));
}

const { slug } = Astro.params;
const topic = getTopic(slug!);
if (!topic) return Astro.redirect('/404');
const L = topic.en;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}/en${p}` || '/en';

const sectionsResolved = L.sections.map((sec) => ({
  ...sec,
  resolvedQuotes: (sec.quotes ?? []).map(resolveTopicQuote),
}));

const relatedSuttas = (L.related_suttas ?? [])
  .map((id) => {
    const s = getSutta(id);
    return s ? { id, label: suttaSeoTitle(s, 'en') } : null;
  })
  .filter(Boolean) as { id: string; label: string }[];
const relatedTopics = (L.related_topics ?? [])
  .map((sl) => {
    const tp = getTopic(sl);
    return tp ? { slug: sl, label: tp.en.title, question: tp.en.question } : null;
  })
  .filter(Boolean) as { slug: string; label: string; question: string }[];
const externalResources = L.external_resources ?? [];

const crumbs = [{ label: t.nav.topics, href: `${base}/en/topics` }, { label: L.title }];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: L.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: L.seo_title,
  description: L.seo_description,
  inLanguage: 'en',
  url: `https://sutta.io/en/topics/${topic.slug}/`,
  dateModified: topic.date,
  author: { '@type': 'Organization', name: 'Canonical Text Study System', url: 'https://sutta.io/' },
  publisher: { '@type': 'Organization', name: 'Canonical Text Study System', url: 'https://sutta.io/' },
  isAccessibleForFree: true,
};
---

<Base
  title={L.seo_title}
  description={L.seo_description}
  crumbs={crumbs}
  extraSchema={[articleSchema, faqSchema]}
>
  <article class="topic">
    <h1>{L.question}</h1>

    <p class="definition">{L.definition}</p>

    <p class="ai-notice">
      <span class="prov-badge prov-ai">AI</span>
      The commentary on this page is AI-written, grounded in the canonical texts on this site
      {topic.review_status === 'draft' && ' (human review in progress)'}; quoted passages are
      canonical and link to the full text for word-by-word verification.
    </p>

    {
      sectionsResolved.map((sec) => (
        <section class="topic-section">
          <h2>{sec.heading}</h2>
          {sec.paragraphs.map((p) => (
            <p class="explain">{p}</p>
          ))}
          {sec.resolvedQuotes.map((q) => (
            <figure class="quote">
              {q.lead && <figcaption class="quote-lead">{q.lead}</figcaption>}
              {q.segments.map((seg) => (
                <div class="quote-seg">
                  {seg.pali && (
                    <p class="quote-pali" lang="pi">
                      {seg.pali}
                    </p>
                  )}
                  {seg.vernacular && <p class="quote-vern">{seg.vernacular}</p>}
                </div>
              ))}
              <figcaption class="quote-src">
                Source:
                <a href={url(`/read/${q.sutta}${q.href_fragment}`)}>
                  <span lang="pi">{q.sutta_title_pali}</span> ({q.sutta.toUpperCase()})
                </a>
                · vernacular is AI-generated per segment (Chinese)
              </figcaption>
            </figure>
          ))}
        </section>
      ))
    }

    {
      L.mahayana_note && (
        <section class="topic-section">
          <h2>Relation to Mahāyāna interpretation</h2>
          <p class="explain">{L.mahayana_note}</p>
        </section>
      )
    }

    <section class="topic-section">
      <h2>FAQ</h2>
      <dl class="faq">
        {
          L.faq.map((f) => (
            <Fragment>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </Fragment>
          ))
        }
      </dl>
    </section>

    {
      (relatedSuttas.length > 0 || relatedTopics.length > 0 || (L.related_lexicon ?? []).length > 0) && (
        <section class="topic-section related">
          <h2>Keep studying</h2>
          <ul>
            {relatedSuttas.map((s) => (
              <li>
                Full text: <a href={url(`/read/${s.id}`)}>{s.label}</a>
              </li>
            ))}
            {relatedTopics.map((tp) => (
              <li>
                Related topic: <a href={url(`/topics/${tp.slug}`)}>{tp.question}</a>
              </li>
            ))}
            {(L.related_lexicon ?? []).map((k) => (
              <li>
                Dictionary: <a href={url(`/lexicon/${k}`)} lang="pi">
                  {k}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      externalResources.length > 0 && (
        <section class="topic-section external-resources">
          <h2>Extended resources</h2>
          <p class="external-note">
            The following is a third-party tool, not part of this site's content or its
            canonical-sourcing standard — offered for readers who may find it useful.
          </p>
          <ul>
            {externalResources.map((r) => (
              <li>
                <a href={r.url} rel="noopener">{r.label}</a> — {r.desc}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

<style>
  .topic h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }
  .definition {
    font-size: var(--text-md);
    line-height: var(--lh-zh);
    padding: var(--space-4);
    background: var(--surface);
    border-left: 3px solid var(--thread);
    border-radius: var(--radius);
    margin-bottom: var(--space-4);
  }
  .ai-notice {
    font-size: var(--text-xs);
    color: var(--margin);
    background: var(--margin-bg);
    border-left: 2px solid var(--margin);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    margin-bottom: var(--space-6);
  }
  .topic-section {
    margin-bottom: var(--space-6);
  }
  h2 {
    font-size: var(--text-base);
    margin: var(--space-6) 0 var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule);
  }
  .explain {
    color: var(--ink);
    margin-bottom: var(--space-3);
  }
  .quote {
    margin: var(--space-4) 0;
    padding: var(--space-4);
    background: var(--paper);
    border-left: 3px solid var(--prov-canonical);
    border-radius: var(--radius);
  }
  .quote-lead {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }
  .quote-seg {
    margin-bottom: var(--space-3);
  }
  .quote-pali {
    font-family: var(--font-pali);
    font-size: var(--size-pali);
    line-height: var(--lh-pali);
    font-style: italic;
    color: var(--ink);
    margin: 0 0 var(--space-1);
  }
  .quote-vern {
    font-family: var(--font-zh);
    font-size: var(--size-zh);
    line-height: var(--lh-zh);
    color: var(--ink);
    margin: 0;
  }
  .quote-src {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }
  .quote-src a {
    color: var(--ink-soft);
  }
  .quote-src a:hover {
    color: var(--thread);
  }
  .faq dt {
    font-weight: 600;
    margin-top: var(--space-4);
  }
  .faq dd {
    margin: var(--space-2) 0 0;
    color: var(--ink-soft);
  }
  .related ul {
    line-height: 2;
  }
  .related a {
    text-decoration: none;
  }
  .related a:hover {
    color: var(--thread);
  }
  .external-resources {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }
  .external-note {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }
  .external-resources ul {
    line-height: 1.8;
  }
</style>
