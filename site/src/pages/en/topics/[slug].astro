---
// en/topics/[slug].astro — Topic pages (tabbed: overview + one tab per section + FAQ). English mirror.
import Base from '../../../layouts/Base.astro';
import ShareButton from '../../../components/ShareButton.astro';
import { getStrings } from '../../../i18n';
const t = getStrings(Astro.currentLocale);
import { listTopics, getTopic, resolveTopicQuote, getSutta, suttaSeoTitle } from '../../../lib/data';
import { QUESTION_CATEGORIES } from '../../../lib/questionMap';

export function getStaticPaths() {
  return listTopics().map((tp) => ({ params: { slug: tp.slug } }));
}

const { slug } = Astro.params;
const topic = getTopic(slug!);
if (!topic) return Astro.redirect('/404');
const L = topic.en;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => {
  const [path, hash] = p.split('#');
  const withSlash = path.endsWith('/') ? path : `${path}/`;
  return `${base}/en${withSlash}${hash ? `#${hash}` : ''}` || '/en';
};

const sectionsResolved = L.sections.map((sec) => ({
  ...sec,
  resolvedQuotes: (sec.quotes ?? []).map(resolveTopicQuote),
}));
const relatedTopics = (L.related_topics ?? [])
  .map((sl) => {
    const tp = getTopic(sl);
    return tp ? { slug: sl, label: tp.en.title } : null;
  })
  .filter(Boolean) as { slug: string; label: string }[];
const relatedSuttas = (L.related_suttas ?? [])
  .map((id) => {
    const s = getSutta(id);
    return s ? { id, label: suttaSeoTitle(s, 'en') } : null;
  })
  .filter(Boolean) as { id: string; label: string }[];

const firstSentence = L.definition.split('. ')[0];
const lede = firstSentence && firstSentence !== L.definition ? firstSentence + '.' : L.definition;
const primaryRead = relatedSuttas[0] ?? null;

const cat = QUESTION_CATEGORIES.find((c) => c.slugs.includes(topic.slug))?.id;
const headline = cat === 'life' ? L.question : L.title.replace(/\([^)]*\)/g, '').trim();
const shortTab = (h: string) => h.split(/[:(（]/)[0].trim();

const crumbs = [{ label: t.nav.topics, href: `${base}/en/topics` }, { label: headline }];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: L.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: L.seo_title,
  description: L.seo_description,
  inLanguage: 'en',
  url: `https://sutta.io/en/topics/${topic.slug}/`,
  dateModified: topic.date,
  author: { '@type': 'Organization', name: 'Canonical Text Study System', url: 'https://sutta.io/' },
  publisher: { '@type': 'Organization', name: 'Canonical Text Study System', url: 'https://sutta.io/' },
  isAccessibleForFree: true,
};
---

<Base title={L.seo_title} description={L.seo_description} crumbs={crumbs} extraSchema={[articleSchema, faqSchema]}>
  <article class="topic-tabbed">
    <h1>{headline}</h1>

    <ShareButton text={L.question} url={`https://sutta.io/en/topics/${topic.slug}/`} lang="en" />

    <div class="ttabs" data-ttabs>
      <div class="ttab-bar" role="tablist" aria-label={headline}>
        <button class="ttab is-active" type="button" role="tab" aria-selected="true" data-tab="ov">Overview</button>
        {sectionsResolved.map((sec, i) => (
          <button class="ttab" type="button" role="tab" aria-selected="false" data-tab={`s${i}`}>{shortTab(sec.heading)}</button>
        ))}
        {L.mahayana_note && <button class="ttab" type="button" role="tab" aria-selected="false" data-tab="mhy">Mahāyāna</button>}
        {L.faq.length > 0 && <button class="ttab" type="button" role="tab" aria-selected="false" data-tab="faq">FAQ</button>}
      </div>

      <div class="ttab-panels">
        <section class="tpanel is-active" data-panel="ov" role="tabpanel">
          <p class="lede">{lede}</p>
          {primaryRead && <a class="read-cta" href={url(`/read/${primaryRead.id}`)}>Read the full sutta: {primaryRead.label} →</a>}
          {relatedTopics.length > 0 && (
            <p class="rel-strip">
              <span class="rel-label">Related: </span>
              {relatedTopics.map((tp, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={url(`/topics/${tp.slug}`)}>{tp.label.replace(/\([^)]*\)/g, '')}</a>
                </>
              ))}
            </p>
          )}
        </section>

        {sectionsResolved.map((sec, i) => (
          <section class="tpanel" data-panel={`s${i}`} role="tabpanel">
            <h2>{sec.heading}</h2>
            {sec.paragraphs.map((p) => <p class="explain">{p}</p>)}
            {sec.resolvedQuotes.map((q) => (
              <figure class="quote">
                {q.lead && <figcaption class="quote-lead">{q.lead}</figcaption>}
                {q.segments.map((seg) => (
                  <div class="quote-seg">
                    {seg.pali && <p class="quote-pali" lang="pi">{seg.pali}</p>}
                    {seg.vernacular && <p class="quote-vern">{seg.vernacular}</p>}
                  </div>
                ))}
                <figcaption class="quote-src">
                  Source:
                  <a href={url(`/read/${q.sutta}${q.href_fragment}`)}><span lang="pi">{q.sutta_title_pali}</span> ({q.sutta.toUpperCase()})</a>
                </figcaption>
              </figure>
            ))}
          </section>
        ))}

        {L.mahayana_note && (
          <section class="tpanel" data-panel="mhy" role="tabpanel">
            <h2>Relation to Mahāyāna interpretation</h2>
            <p class="explain">{L.mahayana_note}</p>
          </section>
        )}

        {L.faq.length > 0 && (
          <section class="tpanel" data-panel="faq" role="tabpanel">
            {L.faq.map((f) => (
              <div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
            ))}
          </section>
        )}
      </div>
    </div>
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-ttabs]').forEach((box) => {
    box.classList.add('js-tabs');
    const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('.ttab'));
    const panels = Array.from(box.querySelectorAll<HTMLElement>('.tpanel'));
    const show = (key: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === key;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === key));
      box.scrollIntoView({ block: 'nearest' });
    };
    tabs.forEach((t) => t.addEventListener('click', () => t.dataset.tab && show(t.dataset.tab)));
  });
</script>

<style>
  .topic-tabbed h1 { font-size: var(--text-xl); line-height: 1.3; margin: var(--space-2) 0 var(--space-4); color: var(--ink); }
  .ttab-bar { display: flex; gap: var(--space-1); overflow-x: auto; border-bottom: 1px solid var(--rule); margin-bottom: var(--space-6); scrollbar-width: thin; }
  .ttab { flex: 0 0 auto; background: transparent; border: none; border-bottom: 2px solid transparent; font-family: var(--font-ui); font-size: var(--text-sm); color: var(--ink-soft); padding: var(--space-2) var(--space-3); cursor: pointer; white-space: nowrap; }
  .ttab.is-active { color: var(--ink); border-bottom-color: var(--thread); }
  .ttab:hover { color: var(--ink); }
  .js-tabs .tpanel { display: none; }
  .js-tabs .tpanel.is-active { display: block; }
  .tpanel + .tpanel { margin-top: var(--space-8); }
  .js-tabs .tpanel + .tpanel { margin-top: 0; }
  .lede { font-size: var(--text-base); line-height: var(--lh-zh); color: var(--ink); margin: var(--space-4) 0 var(--space-3); }
  .read-cta { display: inline-block; font-size: var(--text-base); font-weight: 600; color: var(--thread); text-decoration: none; }
  .read-cta:hover { text-decoration: underline; text-underline-offset: 3px; }
  .rel-strip { margin-top: var(--space-6); padding-top: var(--space-3); border-top: 1px solid var(--rule); font-size: var(--text-sm); color: var(--ink-soft); }
  .rel-strip a { color: var(--ink-soft); text-decoration: none; }
  .rel-strip a:hover { color: var(--thread); }
  .tpanel h2 { font-size: var(--text-lg); margin: 0 0 var(--space-4); color: var(--ink); }
  .explain { color: var(--ink); font-size: var(--size-zh); line-height: var(--lh-zh); margin-bottom: var(--space-3); }
  .quote { margin: var(--space-4) 0; padding: var(--space-4); background: var(--paper); border-inline-start: 3px solid var(--prov-canonical); border-radius: var(--radius); }
  .quote-lead { font-size: var(--text-xs); color: var(--ink-soft); margin-bottom: var(--space-2); }
  .quote-seg { margin-bottom: var(--space-3); }
  .quote-pali { font-family: var(--font-pali); font-size: var(--size-pali); line-height: var(--lh-pali); font-style: italic; color: var(--ink); margin: 0 0 var(--space-1); }
  .quote-vern { font-family: var(--font-zh); font-size: var(--size-zh); line-height: var(--lh-zh); color: var(--ink); margin: 0; }
  .quote-src { font-size: var(--text-xs); color: var(--ink-soft); margin-top: var(--space-2); }
  .quote-src a { color: var(--ink-soft); }
  .quote-src a:hover { color: var(--thread); }
  .faq-item { padding: var(--space-3) 0; border-bottom: 1px solid var(--rule); }
  .faq-item h3 { font-size: var(--text-base); font-weight: 600; color: var(--ink); margin: 0 0 var(--space-2); }
  .faq-item p { margin: 0; color: var(--ink-soft); line-height: var(--lh-zh); }
</style>
