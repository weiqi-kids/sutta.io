---
// en/topics/index.astro — Topics hub (merges former /questions map)
import Base from '../../../layouts/Base.astro';
import { getStrings } from '../../../i18n';
const t = getStrings(Astro.currentLocale);
import { listTopics } from '../../../lib/data';
import { groupTopics } from '../../../lib/questionMap';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}/en${p}` || '/en';
const abs = (p: string) => new URL(url(p), Astro.site ?? 'https://sutta.io').href;
const { groups, leftover } = groupTopics(listTopics());
const allItems = [...groups.flatMap((g) => g.items), ...leftover];

const title = 'Study by Topic — questions answered from the Pāli canon';
const description =
  'What is non-self? How do you practise the four foundations of mindfulness? Common Dhamma questions grouped by core teachings, meditation, everyday struggles and people — each answered from Pāli passages with word-by-word rendering.';
const crumbs = [{ label: t.nav.topics }];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Study by Topic',
  numberOfItems: allItems.length,
  itemListElement: allItems.map((tp, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: tp.en.question,
    url: abs(`/topics/${tp.slug}`),
  })),
};
---

<Base title={title} description={description} crumbs={crumbs} extraSchema={itemListSchema}>
  <h1>Study by Topic</h1>
  <p class="intro">
    Start from the question you have. Each topic answers from the source texts themselves: a one-line
    definition, then Pāli with word-by-word rendering — every quote links into the full sutta.
  </p>

  {
    groups.map((g) => (
      <section class="qgroup" aria-labelledby={`g-${g.id}`}>
        <h2 id={`g-${g.id}`} class="qgroup-h">{g.en}</h2>
        <ul class="qlist">
          {g.items.map((tp) => (
            <li>
              <a href={url(`/topics/${tp.slug}`)}>
                <span class="q">{tp.en.question}</span>
                <span class="def">{tp.en.definition}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    leftover.length > 0 && (
      <section class="qgroup" aria-labelledby="g-more">
        <h2 id="g-more" class="qgroup-h">More topics</h2>
        <ul class="qlist">
          {leftover.map((tp) => (
            <li>
              <a href={url(`/topics/${tp.slug}`)}>
                <span class="q">{tp.en.question}</span>
                <span class="def">{tp.en.definition}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .intro { margin-bottom: var(--space-6); line-height: var(--lh-zh); color: var(--ink-soft); }
  .qgroup { margin-bottom: var(--space-6); }
  .qgroup-h { font-size: var(--text-base); padding-bottom: var(--space-2); margin-bottom: var(--space-2); border-bottom: 1px solid var(--rule); }
  .qlist { list-style: none; padding: 0; margin: 0; }
  .qlist li { border-bottom: 1px solid var(--rule); }
  .qlist a { display: block; padding: var(--space-3) var(--space-1); text-decoration: none; }
  .qlist a:hover .q { color: var(--thread); }
  .q { display: block; font-size: var(--text-base); font-weight: 600; color: var(--ink); margin-bottom: var(--space-1); }
  .def { display: block; font-size: var(--text-sm); color: var(--ink-soft); line-height: var(--lh-zh); }
</style>
