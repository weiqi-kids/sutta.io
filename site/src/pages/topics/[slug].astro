---
// topics/[slug].astro — 主題頁（分頁式：概覽＋各段落各一分頁＋常見問題，每頁約一視窗、不捲）。
// 信任界線：解說＝L2（已校稿，只重排不改字）；引文＝L1（segment_id build 期解析，查無即失敗）。
import Base from '../../layouts/Base.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getStrings } from '../../i18n';
const t = getStrings(Astro.currentLocale);
import { listTopics, getTopic, resolveTopicQuote, getSutta, suttaSeoTitle, getEntityLinkUrls } from '../../lib/data';
import { QUESTION_CATEGORIES } from '../../lib/questionMap';

export function getStaticPaths() {
  return listTopics().map((tp) => ({ params: { slug: tp.slug } }));
}

const { slug } = Astro.params;
const topic = getTopic(slug!);
if (!topic) return Astro.redirect('/404');
const L = topic.zh;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => {
  const [path, hash] = p.split('#');
  const withSlash = path.endsWith('/') ? path : `${path}/`;
  return `${base}${withSlash}${hash ? `#${hash}` : ''}` || '/';
};

// 引文於 build 期解析（防捏造：任何 segment_id 不存在都會讓 build 失敗）
const sectionsResolved = L.sections.map((sec) => ({
  ...sec,
  resolvedQuotes: (sec.quotes ?? []).map(resolveTopicQuote),
}));

const relatedSuttas = (L.related_suttas ?? [])
  .map((id) => {
    const s = getSutta(id);
    return s ? { id, label: suttaSeoTitle(s, 'zh') } : null;
  })
  .filter(Boolean) as { id: string; label: string }[];
const relatedTopics = (L.related_topics ?? [])
  .map((sl) => {
    const tp = getTopic(sl);
    return tp ? { slug: sl, label: tp.zh.title, question: tp.zh.question } : null;
  })
  .filter(Boolean) as { slug: string; label: string; question: string }[];

// 一句直答（definition 首句）＋讀原經 CTA。
const firstSentence = L.definition.split('。')[0];
const lede = firstSentence ? firstSentence + '。' : L.definition;
const primaryRead = relatedSuttas[0] ?? null;

// 標題依「屬性」不同講法：人物→純名字；生活煩惱→日常問句；教義/實踐→概念詞。
const PERSON = new Set(['ananda', 'sariputta', 'moggallana']);
const cat = QUESTION_CATEGORIES.find((c) => c.slugs.includes(topic.slug))?.id;
let headline: string;
if (PERSON.has(topic.slug)) {
  headline = L.title.replace(/^原典中的/, '').replace(/的一生$/, '').trim();
} else if (cat === 'life') {
  headline = L.question;
} else {
  headline = L.title.replace(/（[^）]*）/g, '').split('：')[0].trim();
}
const shortTab = (h: string) => h.split(/[：（(]/)[0].trim();

const crumbs = [{ label: t.nav.topics, href: `${base}/topics` }, { label: headline }];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: L.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const termName = L.title.replace(/（[^）]*）/g, '').trim() || L.title;
const sameAsUrls = getEntityLinkUrls(topic.slug);
// citation（GEO）：本頁所引原典＝可驗證來源。以「直接被引文的經」為主（L1 深連），
// 補上相關經作為延伸來源；全部指向站內 /read 正典頁（真實存在，防捏造）。
const citationMap = new Map<string, { name: string; url: string }>();
for (const sec of sectionsResolved) {
  for (const q of sec.resolvedQuotes) {
    if (!citationMap.has(q.sutta)) {
      citationMap.set(q.sutta, {
        name: `${q.sutta_title_zh}（${q.sutta_title_pali}，${q.sutta.toUpperCase()}）`,
        url: `https://sutta.io/read/${q.sutta}/`,
      });
    }
  }
}
for (const rs of relatedSuttas) {
  if (!citationMap.has(rs.id)) {
    citationMap.set(rs.id, { name: rs.label, url: `https://sutta.io/read/${rs.id}/` });
  }
}
const citationSchema = [...citationMap.values()].map((c) => ({
  '@type': 'CreativeWork',
  name: c.name,
  url: c.url,
}));
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: L.seo_title,
  description: L.seo_description,
  inLanguage: 'zh-Hant',
  url: `https://sutta.io/topics/${topic.slug}/`,
  dateModified: topic.date,
  author: { '@type': 'Organization', name: '原典研經庫', url: 'https://sutta.io/' },
  publisher: { '@type': 'Organization', name: '原典研經庫', url: 'https://sutta.io/' },
  isAccessibleForFree: true,
  // AEO：標出「一句直答」供答案引擎/語音助手擷取
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.lede'] },
  // GEO：把本頁引用的原典標為 citation，讓答案引擎能溯源到可驗證出處
  ...(citationSchema.length ? { citation: citationSchema } : {}),
  // GEO：把本頁主題錨定到已驗證的 Wikidata/維基實體，讓答案引擎正確辨識並引用
  ...(sameAsUrls.length ? { about: { '@type': 'Thing', name: termName, sameAs: sameAsUrls } } : {}),
};
const definedTermSchema = L.definition
  ? {
      '@context': 'https://schema.org',
      '@type': 'DefinedTerm',
      name: termName,
      description: L.definition,
      inDefinedTermSet: { '@type': 'DefinedTermSet', name: '原典研經庫・佛教概念', url: 'https://sutta.io/topics/' },
      url: `https://sutta.io/topics/${topic.slug}/`,
      ...(sameAsUrls.length ? { sameAs: sameAsUrls } : {}),
    }
  : null;
const topicSchema = definedTermSchema ? [articleSchema, faqSchema, definedTermSchema] : [articleSchema, faqSchema];
---

<Base
  title={L.seo_title}
  description={L.seo_description}
  crumbs={crumbs}
  extraSchema={topicSchema}
  ogImage={`https://sutta.io/og/topics/${topic.slug}.png`}
>
  <article class="topic-tabbed">
    <h1>{headline}</h1>

    {/* 金句卡＝常駐主角：永遠直接顯示於標題下、分頁上，切分頁不消失 */}
    <figure class="qcard-fig">
      <img
        class="qcard"
        src={`/og/topics/${topic.slug}.png`}
        width="1200"
        height="630"
        alt={`金句：${lede}`}
        loading="eager"
      />
    </figure>
    <ShareButton
      text={L.question}
      url={`https://sutta.io/topics/${topic.slug}/`}
      cardUrl={`https://sutta.io/og/topics/${topic.slug}.png`}
      prompt="喜歡這句？"
    />

    <div class="ttabs" data-ttabs>
      <div class="ttab-bar" role="tablist" aria-label={headline}>
        <button class="ttab is-active" type="button" role="tab" aria-selected="true" data-tab="ov">概覽</button>
        {sectionsResolved.map((sec, i) => (
          <button class="ttab" type="button" role="tab" aria-selected="false" data-tab={`s${i}`}>
            {shortTab(sec.heading)}
          </button>
        ))}
        {L.mahayana_note && (
          <button class="ttab" type="button" role="tab" aria-selected="false" data-tab="mhy">與大乘</button>
        )}
        {L.faq.length > 0 && (
          <button class="ttab" type="button" role="tab" aria-selected="false" data-tab="faq">常見問題</button>
        )}
      </div>

      <div class="ttab-panels">
        {/* 概覽：金句卡＋分享＋一句直答＋讀原經 */}
        <section class="tpanel is-active" data-panel="ov" role="tabpanel">
          <p class="lede">{lede}</p>
          {primaryRead && (
            <a class="read-cta" href={url(`/read/${primaryRead.id}`)}>讀原經全文《{primaryRead.label}》 →</a>
          )}
          {relatedTopics.length > 0 && (
            <p class="rel-strip">
              <span class="rel-label">相關：</span>
              {relatedTopics.map((tp, i) => (
                <>
                  {i > 0 && '・'}
                  <a href={url(`/topics/${tp.slug}`)}>{tp.label.replace(/（[^）]*）/g, '')}</a>
                </>
              ))}
            </p>
          )}
        </section>

        {/* 各段落各一分頁 */}
        {sectionsResolved.map((sec, i) => (
          <section class="tpanel" data-panel={`s${i}`} role="tabpanel">
            <h2>{sec.heading}</h2>
            {sec.paragraphs.map((p) => (
              <p class="explain">{p}</p>
            ))}
            {sec.resolvedQuotes.map((q) => (
              <figure class="quote">
                {q.lead && <figcaption class="quote-lead">{q.lead}</figcaption>}
                {q.segments.map((seg) => (
                  <div class="quote-seg">
                    {seg.pali && <p class="quote-pali" lang="pi">{seg.pali}</p>}
                    {seg.vernacular && <p class="quote-vern">{seg.vernacular}</p>}
                  </div>
                ))}
                <figcaption class="quote-src">
                  原文出處：
                  <a href={url(`/read/${q.sutta}${q.href_fragment}`)}>
                    《{q.sutta_title_zh}》（<span lang="pi">{q.sutta_title_pali}</span>，{q.sutta.toUpperCase()}）
                  </a>
                </figcaption>
              </figure>
            ))}
          </section>
        ))}

        {L.mahayana_note && (
          <section class="tpanel" data-panel="mhy" role="tabpanel">
            <h2>與大乘詮釋的關係</h2>
            <p class="explain">{L.mahayana_note}</p>
          </section>
        )}

        {L.faq.length > 0 && (
          <section class="tpanel" data-panel="faq" role="tabpanel">
            {L.faq.map((f) => (
              <div class="faq-item">
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))}
          </section>
        )}
      </div>
    </div>
  </article>
</Base>

<script>
  // 分頁：預設全部堆疊（無 JS 也可讀）；JS 開啟後切成一次一頁、不捲。
  document.querySelectorAll<HTMLElement>('[data-ttabs]').forEach((box) => {
    box.classList.add('js-tabs');
    const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('.ttab'));
    const panels = Array.from(box.querySelectorAll<HTMLElement>('.tpanel'));
    const show = (key: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === key;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === key));
      box.scrollIntoView({ block: 'nearest' });
    };
    tabs.forEach((t) => t.addEventListener('click', () => t.dataset.tab && show(t.dataset.tab)));
  });
</script>

<style>
  .topic-tabbed h1 {
    font-size: var(--text-xl);
    line-height: 1.3;
    margin: var(--space-2) 0 var(--space-4);
    color: var(--ink);
  }
  /* 分頁標籤列（可橫向捲，標籤本身不換行） */
  .ttab-bar {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-6);
    scrollbar-width: thin;
  }
  .ttab {
    flex: 0 0 auto;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    white-space: nowrap;
  }
  .ttab.is-active {
    color: var(--ink);
    border-bottom-color: var(--thread);
  }
  .ttab:hover {
    color: var(--ink);
  }
  /* 無 JS：所有分頁堆疊可讀（優雅降級）。有 JS：一次只顯示一頁。 */
  .js-tabs .tpanel {
    display: none;
  }
  .js-tabs .tpanel.is-active {
    display: block;
  }
  .tpanel + .tpanel {
    margin-top: var(--space-8);
  }
  .js-tabs .tpanel + .tpanel {
    margin-top: 0;
  }
  /* 概覽 */
  .qcard-fig {
    margin: 0 0 var(--space-3);
  }
  .qcard {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .lede {
    font-family: var(--font-zh);
    font-size: var(--text-base);
    line-height: var(--lh-zh);
    color: var(--ink);
    margin: var(--space-4) 0 var(--space-3);
  }
  .read-cta {
    display: inline-block;
    font-family: var(--font-zh);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--thread);
    text-decoration: none;
  }
  .read-cta:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rel-strip {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  .rel-strip .rel-label {
    font-family: var(--font-ui);
  }
  .rel-strip a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .rel-strip a:hover {
    color: var(--thread);
  }
  /* 段落分頁 */
  .tpanel h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-4);
    color: var(--ink);
  }
  .explain {
    color: var(--ink);
    font-size: var(--size-zh);
    line-height: var(--lh-zh);
    margin-bottom: var(--space-3);
  }
  .quote {
    margin: var(--space-4) 0;
    padding: var(--space-4);
    background: var(--paper);
    border-inline-start: 3px solid var(--prov-canonical);
    border-radius: var(--radius);
  }
  .quote-lead {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }
  .quote-seg {
    margin-bottom: var(--space-3);
  }
  .quote-pali {
    font-family: var(--font-pali);
    font-size: var(--size-pali);
    line-height: var(--lh-pali);
    font-style: italic;
    color: var(--ink);
    margin: 0 0 var(--space-1);
  }
  .quote-vern {
    font-family: var(--font-zh);
    font-size: var(--size-zh);
    line-height: var(--lh-zh);
    color: var(--ink);
    margin: 0;
  }
  .quote-src {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }
  .quote-src a {
    color: var(--ink-soft);
  }
  .quote-src a:hover {
    color: var(--thread);
  }
  /* 常見問題分頁 */
  .faq-item {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .faq-item h3 {
    font-family: var(--font-zh);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }
  .faq-item p {
    margin: 0;
    color: var(--ink-soft);
    line-height: var(--lh-zh);
  }
</style>
