---
import Base from '../layouts/Base.astro';
import { getStrings } from '../i18n';
const t = getStrings(Astro.currentLocale);
import { listSuttas } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p.endsWith('/') ? p : `${p}/`}` || '/';
const suttas = listSuttas();
const anyPreview = suttas.some((s) => s.isPreview);
const crumbs = [{ label: t.nav.browse }];
---

<Base title={t.browse.title} description={t.browse.desc} crumbs={crumbs} preview={anyPreview}>
  <h1>{t.browse.title}・{t.browse.collectionMN}</h1>
  <nav class="collection-views" aria-label="經藏視圖">
    <a href={url('/nikaya')}>
      <span class="cv-label">{t.nav.nikaya}</span>
      <span class="cv-sub calm-note">五部尼柯耶與中文譯本現況</span>
    </a>
    <a href={url('/agama')}>
      <span class="cv-label">{t.nav.agama}</span>
      <span class="cv-sub calm-note">中阿含 ↔ 中部 對照，直達漢譯原文</span>
    </a>
  </nav>
  <table class="browse-table">
    <thead>
      <tr>
        <th>{t.browse.colNo}</th>
        <th>{t.browse.colTitlePali}</th>
        <th>{t.browse.colTitleZh}</th>
        <th>{t.browse.colParallel}</th>
        <th>{t.browse.colReviewed}</th>
      </tr>
    </thead>
    <tbody>
      {
        suttas.map((s) => (
          <tr>
            <td class="data">{s.id}</td>
            <td>
              <a href={url(`/read/${s.id}`)} lang="pi">
                {s.title_pali}
              </a>
            </td>
            <td>{s.title_zh}</td>
            <td>{s.hasParallel ? t.browse.hasParallel : t.browse.noParallel}</td>
            <td class="calm-note">{s.reviewed ? t.browse.reviewed : t.browse.draft}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>

<style>
  .collection-views {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .collection-views a {
    flex: 1 1 240px;
    display: block;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
  }
  .collection-views a:hover {
    border-color: var(--thread);
  }
  .cv-label {
    display: block;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-1);
  }
  .cv-sub {
    display: block;
    font-size: var(--text-sm);
  }
  .browse-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }
  .browse-table th,
  .browse-table td {
    text-align: start;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .browse-table th {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    font-weight: 600;
  }
  .browse-table a {
    text-decoration: none;
  }
  .browse-table a:hover {
    color: var(--thread);
  }
</style>
