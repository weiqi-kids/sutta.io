---
import Base from '../layouts/Base.astro';
import { getStrings } from '../i18n';
const t = getStrings(Astro.currentLocale);
import { listSuttas, listTopics } from '../lib/data';
import { pickTopics, HOME_FEATURED_QUESTIONS } from '../lib/questionMap';
import DailyVerseCard from '../components/DailyVerseCard.astro';
import { todaysVerse } from '../lib/dailyVerse';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}` || '/';
const suttas = listSuttas();
const daily = todaysVerse();
// 精選一部代表經作為閱讀入口示範（SITE_IA §4）
const featured = suttas.find((s) => s.reviewed && !s.isPreview) ?? suttas[0];
// 問題入口：跨類精選常見佛法問題，第一屏就以「提問」承接使用者與 AI（AEO/GEO）
const askQuestions = pickTopics(listTopics(), HOME_FEATURED_QUESTIONS);
// 首頁收斂為單一目標（一個問題／一部經）；常見問題（FAQ）與其 FAQPage schema 移至 /about。
---

<Base title={undefined}>
  <section class="hero">
    <h1 class="hero-title">{t.site.name}</h1>
    <p class="hero-value">{t.home.valueLine}</p>
    <p class="hero-tagline calm-note">{t.site.tagline}</p>
    <p class="unofficial calm-note">
      {t.site.unofficial}・<a href={url('/about')}>{t.nav.about}</a>
    </p>
  </section>

  {
    askQuestions.length > 0 && (
      <section class="ask" aria-labelledby="ask-h">
        <h2 id="ask-h" class="ask-h">{t.home.askTitle}</h2>
        <ul class="ask-list">
          {askQuestions.map((tp) => (
            <li>
              <a href={url(`/topics/${tp.slug}`)}>{tp.zh.question}</a>
            </li>
          ))}
        </ul>
        <a class="ask-more" href={url('/topics')}>
          {t.home.askMore} →
        </a>
      </section>
    )
  }

  {
    daily && (
      <DailyVerseCard
        verse={daily}
        base={base}
        label={t.daily.homeCardLabel}
        sourceLabel={t.daily.sourceLabel}
        readMore={t.daily.readMore}
      />
    )
  }

  <p class="tools-label calm-note">{t.home.toolsLabel}</p>
  <nav class="entries" aria-label="主要入口">
    <a class="entry" href={url('/browse')}>
      <span class="entry-label">{t.home.browseCollection}</span>
      <span class="entry-sub calm-note">{t.browse.collectionMN}</span>
    </a>
    <a class="entry" href={url('/search')}>
      <span class="entry-label">{t.home.searchEntry}</span>
    </a>
    <a class="entry" href={url('/lexicon')}>
      <span class="entry-label">{t.home.lexiconEntry}</span>
    </a>
    <a class="entry" href={url('/world')}>
      <span class="entry-label">{t.home.worldEntry}</span>
    </a>
  </nav>

  {
    featured && (
      <section class="featured">
        <span class="featured-label calm-note">{t.home.featuredLabel}</span>
        <a class="featured-link" href={url(`/read/${featured.id}`)}>
          <span lang="pi" class="featured-pali">
            {featured.title_pali}
          </span>
          <span class="featured-zh">{featured.title_zh}</span>
        </a>
      </section>
    )
  }
</Base>

<style>
  .hero {
    margin: var(--space-8) 0 var(--space-6);
  }
  .hero-title {
    font-size: var(--size-title);
    margin: 0 0 var(--space-2);
  }
  .hero-value {
    font-family: var(--font-zh);
    font-size: var(--text-md);
    color: var(--ink);
    line-height: var(--lh-zh);
    margin: 0 0 var(--space-2);
  }
  .hero-tagline {
    margin: 0 0 var(--space-3);
  }
  .ask {
    margin: var(--space-6) 0;
  }
  .ask-h {
    font-size: var(--text-base);
    margin: 0 0 var(--space-3);
  }
  .ask-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-4);
  }
  .ask-list a {
    display: block;
    padding: var(--space-2) 0;
    font-family: var(--font-zh);
    font-size: var(--text-sm);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .ask-list a:hover {
    color: var(--thread);
  }
  .ask-more {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .tools-label {
    margin: var(--space-8) 0 var(--space-2);
  }
  .entries {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .entry:hover {
    border-color: var(--thread);
  }
  .entry-label {
    font-family: var(--font-ui);
    color: var(--ink);
    font-size: var(--text-sm);
  }
  .faq {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .faq h2 {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }
  .faq-item {
    border-bottom: 1px solid var(--rule);
    padding: var(--space-2) 0;
  }
  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-ui);
    color: var(--ink);
    font-size: var(--text-sm);
  }
  .faq-item p {
    color: var(--ink-soft);
    margin: var(--space-2) 0 0;
    line-height: var(--lh-zh);
  }
  .featured {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .featured-label {
    display: block;
    margin-bottom: var(--space-2);
  }
  .featured-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    text-decoration: none;
  }
  .featured-pali {
    font-size: var(--text-md);
    color: var(--ink);
  }
  .featured-zh {
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .entries {
      grid-template-columns: 1fr;
    }
    .ask-list {
      grid-template-columns: 1fr;
    }
  }
</style>
