---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import StudyPage from '../../components/study/StudyPage';
import ShareButton from '../../components/ShareButton.astro';
import { getStrings } from '../../i18n';
const t = getStrings(Astro.currentLocale);
import { listSuttas, getSutta, isPreviewSutta, getSuttaContext, getEntitiesForSutta, suttaSeoTitle, getTopicsForSutta, getCrossRefs } from '../../lib/data';

export function getStaticPaths() {
  const suttas = listSuttas();
  return suttas.map((s, i) => ({
    params: { sutta: s.id },
    props: {
      prevId: i > 0 ? suttas[i - 1].id : null,
      nextId: i < suttas.length - 1 ? suttas[i + 1].id : null,
    },
  }));
}

const { sutta: suttaId } = Astro.params;
const { prevId, nextId } = Astro.props as { prevId: string | null; nextId: string | null };
const fixture = getSutta(suttaId!);

if (!fixture) {
  return Astro.redirect('/404');
}

const preview = isPreviewSutta(fixture);
// 每頁專屬分享金句卡（僅在該經有產卡時使用，缺概要的經 fallback 通用圖）
const ogCard = fs.existsSync(path.join(process.cwd(), 'public/og/read', `${suttaId}.png`))
  ? `https://sutta.io/og/read/${suttaId}.png`
  : undefined;
const context = getSuttaContext(suttaId!);
const entities = getEntitiesForSutta(suttaId!);
const relatedTopics = getTopicsForSutta(suttaId!, Astro.currentLocale === 'en' ? 'en' : 'zh');
const xrefs = getCrossRefs(suttaId!);
const l3Api = (import.meta.env.PUBLIC_L3_API ?? '').replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const crumbs = [
  { label: fixture.sutta.collection_zh ?? fixture.sutta.collection, href: `${base}/browse/` },
  { label: fixture.sutta.title_zh },
];

const { sutta, summary, manifest, passages } = fixture;
const hasAgama = passages.some((p) => p.agama != null);

const fallbackDescription = `${sutta.title_pali}（${sutta.title_zh}）逐字巴利解析與漢譯對照`;
function buildDescription(): string {
  if (summary?.review_status === 'approved' && summary.content && summary.content.trim()) {
    const collapsed = summary.content.replace(/\s+/g, ' ').trim();
    return collapsed.length > 150 ? `${collapsed.slice(0, 150)}…` : collapsed;
  }
  return fallbackDescription;
}
const description = buildDescription();

const pageUrl = `https://sutta.io/read/${sutta.id}/`;
const dateModified = manifest?.built_at ? manifest.built_at.slice(0, 10) : undefined;

const citation: Array<Record<string, string>> = [
  { '@type': 'CreativeWork', name: 'SuttaCentral (Mahāsaṅgīti)', url: 'https://suttacentral.net/' },
  { '@type': 'CreativeWork', name: 'Digital Pāḷi Dictionary (DPD)', url: 'https://digitalpalidictionary.github.io/' },
];
if (hasAgama) {
  citation.push({ '@type': 'CreativeWork', name: 'CBETA 漢文大藏經', url: 'https://www.cbeta.org/' });
}

const organization = {
  '@type': 'Organization',
  name: '原典研經庫',
  alternateName: 'Canonical Text Study System',
  url: 'https://sutta.io/',
};

const articleSchema: Record<string, unknown> = {
  '@type': ['Article', 'CreativeWork'],
  headline: `${sutta.title_pali}（${sutta.title_zh}）`,
  name: `${sutta.title_pali}（${sutta.title_zh}）`,
  description,
  inLanguage: ['pi', 'zh-Hant'],
  about: [
    { '@type': 'Thing', name: sutta.title_pali },
    { '@type': 'Thing', name: sutta.title_zh },
    { '@type': 'Thing', name: 'Pāli Canon' },
  ],
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: sutta.collection_zh ?? sutta.collection,
    inLanguage: 'pi',
  },
  url: pageUrl,
  author: organization,
  publisher: organization,
  isAccessibleForFree: true,
  license: 'https://sutta.io/about/',
  citation,
};
if (dateModified) {
  articleSchema.dateModified = dateModified;
}
---

<Base
  title={suttaSeoTitle(fixture, 'zh')}
  description={description}
  crumbs={crumbs}
  preview={preview}
  wide={true}
  extraSchema={articleSchema}
  ogImage={ogCard}
>
  <StudyPage client:load fixture={fixture} prevId={prevId} nextId={nextId} baseUrl={base} context={context} entities={entities} topics={relatedTopics} pericopes={xrefs.pericopes} l3Api={l3Api} lang={Astro.currentLocale} />
  {
    (relatedTopics.length > 0 || xrefs.parallels.length > 0 || ogCard) && (
      <div class="container">
        <div class="measure">
          {xrefs.parallels.length > 0 && (
            <nav class="read-parallels" aria-label={t.study.relatedSuttas}>
              <span class="rt-label calm-note">{t.study.relatedSuttas}</span>
              <p class="rp-hint calm-note">{t.study.relatedSuttasHint}</p>
              <ul>
                {xrefs.parallels.map((p) => (
                  <li>
                    <a href={`${base}/read/${p.sutta}/`}>
                      <span lang="pi" class="rp-pali">{p.title_pali}</span>
                      <span class="rp-zh">{p.title_zh}</span>
                    </a>
                    {p.full && <span class="rp-full calm-note">{t.study.parallelFull}</span>}
                  </li>
                ))}
              </ul>
            </nav>
          )}
          {relatedTopics.length > 0 && (
            <nav class="read-topics" aria-label={t.study.relatedTopics}>
              <span class="rt-label calm-note">{t.study.relatedTopics}</span>
              <ul>
                {relatedTopics.map((tp) => (
                  <li>
                    <a href={`${base}/topics/${tp.slug}/`}>{tp.question}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          {ogCard && <ShareButton text={suttaSeoTitle(fixture, 'zh')} url={pageUrl} cardUrl={ogCard} />}
        </div>
      </div>
    )
  }

  <style>
    .read-parallels {
      margin: var(--space-6) 0 0;
      padding: var(--space-4);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .read-parallels .rt-label {
      display: block;
      font-family: var(--font-ui);
      font-size: var(--text-xs);
      margin-bottom: var(--space-1);
    }
    .read-parallels .rp-hint {
      font-size: var(--text-2xs);
      margin: 0 0 var(--space-3);
    }
    .read-parallels ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .read-parallels a {
      text-decoration: none;
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-2);
    }
    .read-parallels a:hover .rp-zh {
      color: var(--thread);
    }
    .read-parallels .rp-pali {
      font-family: var(--font-pali);
      font-size: var(--text-sm);
      color: var(--ink);
    }
    .read-parallels .rp-zh {
      font-family: var(--font-zh);
      font-size: var(--text-sm);
    }
    .read-parallels .rp-full {
      font-size: var(--text-2xs);
    }
    .read-topics {
      margin: var(--space-6) 0 0;
      padding: var(--space-4);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .read-topics .rt-label {
      display: block;
      font-family: var(--font-ui);
      font-size: var(--text-xs);
      margin-bottom: var(--space-2);
    }
    .read-topics ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-4);
    }
    .read-topics a {
      font-family: var(--font-zh);
      font-size: var(--text-sm);
      text-decoration: none;
    }
    .read-topics a:hover {
      color: var(--thread);
    }
  </style>
</Base>
